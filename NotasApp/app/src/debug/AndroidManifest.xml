<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo aplica al build de debug: permite tráfico HTTP (sin TLS) para poder apuntar
  a un backend local (http://10.0.2.2:3000/ en el emulador, o la IP de la PC en
  un dispositivo físico) mientras se desarrolla. El build de release NO hereda esto,
  así que sigue exigiendo HTTPS.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
